{
  "schema_version": "1.0.0",
  "updated_at": "2026-08-16",
  "default_language": "zh-CN",
  "selection_policy": {
    "max_primary_advisors": 2,
    "max_total_advisors": 4,
    "prefer": [
      "active status",
      "direct creator transcript or creator-authored outline",
      "high confidence",
      "specific topic match"
    ],
    "diversity_rule": "有多个同等相关且证据足够的创作者时，优先覆盖至少两位；不得为凑多样性而提升低质量证据。",
    "weak_evidence_rule": "只有标题、简介、二手摘要或暂定转述时，必须在回答正文紧邻建议处标注，不得升级为步骤级结论。",
    "general_advice_rule": "创作者语料不足时先明确“联合体语料未覆盖”，再以“通用科研建议”单独给出，不伪装成任何成员观点。",
    "conflict_rule": "命中 disagreements.jsonl 时先并列观点与适用条件，再给条件化选择；不得捏造共识。",
    "commercial_rule": "引用存在销售、联盟或行业关联的成员时，按 commercial-conflicts.jsonl 在同一回答中披露。",
    "integrity_rule": "任何完整请求或子请求命中 integrity-rules.json 的 forbidden 类别时拒绝危险部分；不得让合法部分掩盖违规意图。"
  },
