{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunccchengze/-SKILL-/schemas/ai-research-senpai-council/commercial-conflict-record.schema.json",
  "title": "AI Research Senpai Council commercial conflict record",
  "description": "Schema for each JSON Lines row in references/governance/commercial-conflicts.jsonl.",
  "type": "object",
  "required": [
    "conflict_id", "creator_id", "level", "summary", "source_ids",
    "response_action", "checked_at"
  ],
  "properties": {
    "conflict_id": {"type": "string", "pattern": "^COM-[0-9]{3}$"},
    "creator_id": {"$ref": "#/$defs/creatorId"},
    "level": {"enum": ["unknown", "high", "medium", "low_or_unknown"]},
    "summary": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "response_action": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false,
  "$defs": {
    "creatorId": {
      "enum": [
        "zoey", "yang-shixiong", "mai-xiaozhe", "simin", "he-jing", "li-mu",
        "andy-stapleton", "amina-yonis", "tara-brabazon", "james-hayton",
        "kriukow", "academic-english-now"
      ]
    }
  }
}
