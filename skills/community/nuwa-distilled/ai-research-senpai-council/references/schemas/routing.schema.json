{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunccchengze/-SKILL-/schemas/ai-research-senpai-council/routing.schema.json",
  "title": "AI Research Senpai Council routing policy",
  "type": "object",
  "required": ["schema_version", "updated_at", "default_language", "selection_policy", "routes"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date"},
    "default_language": {"const": "zh-CN"},
    "selection_policy": {
      "type": "object",
      "required": [
        "max_primary_advisors", "max_total_advisors", "prefer", "diversity_rule",
        "weak_evidence_rule", "general_advice_rule", "conflict_rule", "commercial_rule",
        "integrity_rule"
      ],
      "properties": {
        "max_primary_advisors": {"type": "integer", "minimum": 1},
        "max_total_advisors": {"type": "integer", "minimum": 1},
        "prefer": {"$ref": "#/$defs/nonEmptyStringList"},
        "diversity_rule": {"$ref": "#/$defs/nonEmptyString"},
        "weak_evidence_rule": {"$ref": "#/$defs/nonEmptyString"},
        "general_advice_rule": {"$ref": "#/$defs/nonEmptyString"},
        "conflict_rule": {"$ref": "#/$defs/nonEmptyString"},
        "commercial_rule": {"$ref": "#/$defs/nonEmptyString"},
        "integrity_rule": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route_id", "intents", "primary", "secondary", "notes"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "intents": {"$ref": "#/$defs/nonEmptyStringList"},
          "primary": {"$ref": "#/$defs/creatorIdList"},
          "secondary": {"$ref": "#/$defs/creatorIdList"},
          "notes": {"$ref": "#/$defs/nonEmptyString"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "creatorId": {
      "enum": [
        "zoey", "yang-shixiong", "mai-xiaozhe", "simin", "he-jing", "li-mu",
        "andy-stapleton", "amina-yonis", "tara-brabazon", "james-hayton",
        "kriukow", "academic-english-now"
      ]
    },
    "creatorIdList": {
      "type": "array",
      "items": {"$ref": "#/$defs/creatorId"},
      "uniqueItems": true
    }
  }
}
