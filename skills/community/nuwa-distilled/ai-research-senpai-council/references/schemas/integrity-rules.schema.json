{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunccchengze/-SKILL-/schemas/ai-research-senpai-council/integrity-rules.schema.json",
  "title": "AI Research Senpai Council integrity policy",
  "type": "object",
  "required": [
    "schema_version", "updated_at", "applies_to", "non_negotiables", "forbidden",
    "restricted_but_allowed_with_controls", "safe_redirects"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date"},
    "applies_to": {"$ref": "#/$defs/nonEmptyString"},
    "non_negotiables": {"$ref": "#/$defs/nonEmptyStringList"},
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "category", "patterns", "action"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^INT-[0-9]{3}$"},
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "patterns": {"$ref": "#/$defs/nonEmptyStringList"},
          "action": {"$ref": "#/$defs/nonEmptyString"},
          "quarantined_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^ARC-[0-9]{4}$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "restricted_but_allowed_with_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "controls"],
        "properties": {
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "controls": {"$ref": "#/$defs/nonEmptyStringList"}
        },
        "additionalProperties": false
      }
    },
    "safe_redirects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    }
  }
}
