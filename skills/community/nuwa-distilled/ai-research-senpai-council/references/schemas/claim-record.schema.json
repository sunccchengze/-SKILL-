{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunccchengze/-SKILL-/schemas/ai-research-senpai-council/claim-record.schema.json",
  "title": "AI Research Senpai Council claim record",
  "description": "Schema for each JSON Lines row in references/knowledge/claims.jsonl.",
  "type": "object",
  "required": [
    "claim_id", "creator_id", "statement", "statement_type", "evidence_modality",
    "coverage", "confidence", "source_ids", "topics", "keywords", "route_tags",
    "actions", "warnings", "status", "directness", "checked_at"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^ARC-[0-9]{4}$"},
    "creator_id": {"$ref": "#/$defs/creatorId"},
    "statement": {"type": "string", "minLength": 1},
    "statement_type": {
      "enum": [
        "creator_statement", "description_level_summary", "title_level_theme",
        "commercial_disclosure", "institutional_fact", "secondary_summary", "risk_notice"
      ]
    },
    "evidence_modality": {"$ref": "#/$defs/modality"},
    "coverage": {
      "enum": [
        "partial_mediated_export", "title_description_only", "related_collection_metadata",
        "creator_outline", "institutional_page", "secondary_article", "full_transcript",
        "creator_page_and_description", "channel_metadata_only"
      ]
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "source_ids": {"$ref": "#/$defs/nonEmptyStringList"},
    "topics": {"$ref": "#/$defs/stringList"},
    "keywords": {"$ref": "#/$defs/stringList"},
    "route_tags": {"$ref": "#/$defs/stringList"},
    "actions": {"$ref": "#/$defs/stringList"},
    "warnings": {"$ref": "#/$defs/stringList"},
    "status": {"enum": ["active", "context_only", "quarantined"]},
    "directness": {"enum": ["direct", "indirect", "secondary"]},
    "checked_at": {"type": "string", "format": "date"},
    "inherited_claim_ids": {"$ref": "#/$defs/nonEmptyStringList"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "quarantined"}}, "required": ["status"]},
      "then": {"properties": {"warnings": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"statement_type": {"const": "secondary_summary"}}, "required": ["statement_type"]},
      "then": {"properties": {"directness": {"const": "secondary"}}}
    }
  ],
  "$defs": {
    "creatorId": {
      "enum": [
        "zoey", "yang-shixiong", "mai-xiaozhe", "simin", "he-jing", "li-mu",
        "andy-stapleton", "amina-yonis", "tara-brabazon", "james-hayton",
        "kriukow", "academic-english-now"
      ]
    },
    "modality": {
      "enum": [
        "mediated_export", "creator_description", "creator_authored_outline",
        "institutional_profile", "secondary_summary", "creator_transcript",
        "related_video_metadata"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
